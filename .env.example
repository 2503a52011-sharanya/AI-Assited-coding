# Environment variables for AI Smart Travel and Tourism Recommendation System
SECRET_KEY=django-insecure-smart-tourism-ai-super-secret-key-prod-2026!
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database Configuration (MySQL as primary, automatic graceful fallback if service unavailable)
DB_ENGINE=mysql
DB_NAME=ai_smart_tourism
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Google Gemini API Key for AI Travel Chatbot & Dynamic Recommendations
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenWeather API Key for live weather and forecast
# Get one from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Razorpay Test API Keys for booking payments
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_demo123456789
RAZORPAY_KEY_SECRET=demoSecretKey987654321
