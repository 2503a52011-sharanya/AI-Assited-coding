# ===================================================================
# SMART TOURISM PLATFORM CONFIGURATION
# ===================================================================

# Database Configuration
# For MySQL: mysql+pymysql://username:password@localhost:3306/smart_tourism
# For SQLite fallback (default out of the box): sqlite:///smart_tourism.db
DATABASE_URL=sqlite:///smart_tourism.db

# Application Security
SECRET_KEY=smart_tourism_super_secret_session_key_2026

# External API Keys (Optional - App automatically runs in DEMO MODE if omitted)
WEATHER_API_KEY=
MAP_API_KEY=
FLIGHT_API_KEY=
HOTEL_API_KEY=
PAYMENT_API_KEY=
PAYMENT_SECRET=

# External API URLs (Optional Overrides)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
